FROM ghcr.io/cirruslabs/android-sdk:35

LABEL maintainer="WeatherWall Project"
LABEL description="Cached build environment for WeatherWall Android app"

# 1. Setup environment for numeric user 1000
#    We set HOME explicitly because USER 1000 might not have an /etc/passwd entry
ENV HOME=/home/builder
ENV GRADLE_USER_HOME=$HOME/.gradle

# 2. Create home directory and workspace with correct permissions
#    Using numeric ID 1000:1000 bypasses name conflict issues
RUN mkdir -p $GRADLE_USER_HOME && \
    chown -R 1000:1000 /home/builder && \
    mkdir -p /workspace && \
    chown 1000:1000 /workspace

# 3. Switch to numeric user immediately
USER 1000:1000
WORKDIR /workspace

# 4. Copy build definitions with correct ownership
#    We use --chown=1000:1000 so the files are owned by our user
COPY --chown=1000:1000 gradle gradle
COPY --chown=1000:1000 gradlew gradle.properties settings.gradle.kts build.gradle.kts ./
COPY --chown=1000:1000 app/build.gradle.kts app/

# 5. Make executable
RUN chmod +x gradlew

# 6. Download and cache dependencies
#    This runs as user 1000, storing files in /home/builder/.gradle
RUN ./gradlew dependencies --no-daemon && \
    ./gradlew :app:dependencies --no-daemon

# 7. Entrypoint
CMD ["./gradlew", "test", "assembleDebug", "--no-daemon"]
