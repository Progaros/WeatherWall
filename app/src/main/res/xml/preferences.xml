<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Scene Settings -->
    <PreferenceCategory android:title="Scene">
        <SeekBarPreference
            android:key="pref_random_seed"
            android:title="Random Seed"
            android:summary="Changes mountain/tree/cloud placement (1-999)"
            android:defaultValue="208"
            android:max="999"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_density"
            android:title="Mountain Density"
            android:summary="Mountain coverage (0=none, 100=dense)"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_width"
            android:title="Mountain Width"
            android:summary="Width scale (50=narrow, 100=normal, 200=wide)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_height"
            android:title="Mountain Height"
            android:summary="Height scale (50=short, 100=normal, 200=tall)"
            android:defaultValue="100"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_roughness"
            android:title="Mountain Roughness"
            android:summary="Jaggedness of silhouette (0-200%)"
            android:defaultValue="80"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_ridge_roughness"
            android:title="Ridge Roughness"
            android:summary="Center ridge jaggedness (0-200%)"
            android:defaultValue="50"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_bottom_offset"
            android:title="Mountain Bottom Offset"
            android:summary="Shift mountains up (0=at bottom, 50=halfway up screen)"
            android:defaultValue="0"
            android:max="50"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_count"
            android:title="Hill Layers"
            android:summary="Rolling terrain layers (0=none, 5=normal, 20=many)"
            android:defaultValue="5"
            android:max="20"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_lower_start"
            android:title="Hills Start Position"
            android:summary="Where far hills appear on screen (30-70%)"
            android:defaultValue="60"
            android:max="70"
            app:min="30"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_upper_end"
            android:title="Hills End Position"
            android:summary="Where near hills appear on screen (60-100%)"
            android:defaultValue="95"
            android:max="100"
            app:min="60"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_roughness"
            android:title="Hill Roughness"
            android:summary="Hill curve detail (0=smooth, 100=normal, 200=rough)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_amplitude"
            android:title="Hill Height"
            android:summary="Vertical scale (0=flat, 100=normal, 1000=extreme)"
            android:defaultValue="354"
            android:max="1000"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_frequency"
            android:title="Hill Frequency"
            android:summary="Hills per layer (50=few, 100=normal, 200=many)"
            android:defaultValue="170"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_distance"
            android:title="Hill Distance"
            android:summary="Pushes hills away (0=at camera, 100=near mountains)"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_depth_spread"
            android:title="Hill Depth Spread"
            android:summary="Z-axis spread (0=flat layer, 100=deep range)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_density"
            android:title="Tree Density"
            android:summary="Tree coverage (0=none, 50=normal, 200=dense forest)"
            android:defaultValue="50"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_spread"
            android:title="Tree Spread"
            android:summary="How far along hills trees are placed (0=peaks only, 100=full hillside)"
            android:defaultValue="80"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_sparsity"
            android:title="Tree Sparsity"
            android:summary="Gap size (0=uniform, 30=natural, 80=sparse)"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_size_randomness"
            android:title="Tree Size Randomness"
            android:summary="Variation in tree sizes (0=uniform, 100=varied)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_size"
            android:title="Tree Height"
            android:summary="Tree size (50=small, 100=normal, 200=tall)"
            android:defaultValue="100"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_width"
            android:title="Tree Width"
            android:summary="Width as % of height (100 = proportional)"
            android:defaultValue="100"
            android:max="200"
            app:min="20"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_segments"
            android:title="Tree Segments"
            android:summary="Tiers per tree (1-5, fewer = taller)"
            android:defaultValue="1"
            android:max="5"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_color_variation"
            android:title="Tree Color Variation"
            android:summary="Color diversity (0=uniform, 100=varied)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <!-- Wind Effects -->
    <PreferenceCategory android:title="Wind Effects">
        <SeekBarPreference
            android:key="pref_wind_multiplier"
            android:title="Wind Effect Strength"
            android:summary="Tree sway intensity (0=none, 100=subtle, 200=normal, 300=extreme)"
            android:defaultValue="200"
            android:max="300"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_sway_speed"
            android:title="Tree Sway Speed"
            android:summary="Sway animation speed (0=frozen, 100=normal, 200=fast)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <!-- 3D Parallax Settings -->
    <PreferenceCategory android:title="3D Parallax">
        <SwitchPreferenceCompat
            android:key="pref_parallax_enabled"
            android:title="Enable 3D Parallax"
            android:summary="Sensor-based parallax effect"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_parallax_strength"
            android:title="Tilt Sensitivity"
            android:summary="Response to phone tilt (1%=subtle, 100%=high)"
            android:defaultValue="16"
            android:max="100"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_max_offset"
            android:title="Max Movement"
            android:summary="Scene shift as % of screen height (2-40%)"
            android:defaultValue="40"
            android:max="40"
            app:min="2"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_return_speed"
            android:title="Return Speed"
            android:summary="Recenter speed (0=stay, 50=~0.3s, 100=instant)"
            android:defaultValue="47"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_smoothing"
            android:title="Smoothing"
            android:summary="Movement smoothness (0=instant, 1=responsive, 100=floaty)"
            android:defaultValue="1"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_edge_easing"
            android:title="Edge Easing"
            android:summary="Slowdown near edges (0=linear, 50=soft, 100=center-only)"
            android:defaultValue="10"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_parallax_return_unlocked"
            android:title="Fast Return"
            android:summary="Return to center ignores edge easing (always fast)"
            android:defaultValue="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_depth"
            android:title="Depth Effect"
            android:summary="Layer separation (0=flat, 50=normal, 100=max 3D)"
            android:defaultValue="70"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_parallax_invert_x"
            android:title="Invert Horizontal"
            android:summary="Reverse left/right parallax direction"
            android:defaultValue="false"
            android:dependency="pref_parallax_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_parallax_invert_y"
            android:title="Invert Vertical"
            android:summary="Reverse up/down parallax direction"
            android:defaultValue="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_aspect_ratio"
            android:title="H/V Ratio"
            android:summary="Horizontal vs vertical movement (50=less H, 100=equal, 150=more H)"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />
    </PreferenceCategory>

    <!-- Visual Effects -->
    <!-- Cloud Settings -->
    <PreferenceCategory android:title="Cloud Settings">
        <SwitchPreferenceCompat
            android:key="pref_clouds_enabled"
            android:title="Clouds"
            android:summary="Enable moving clouds in the sky"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_cloud_density"
            android:title="Cloud Fluffiness"
            android:summary="Density per cloud (50=thin, 100=normal, 300=fluffy)"
            android:defaultValue="100"
            android:max="300"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_stretch"
            android:title="Cloud Stretch"
            android:summary="Horizontal stretch (200-400=normal, 500=wispy)"
            android:defaultValue="300"
            android:max="500"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_opacity"
            android:title="Cloud Opacity"
            android:summary="Transparency (10=very see-through, 100=solid)"
            android:defaultValue="60"
            android:max="100"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_speed"
            android:title="Cloud Speed"
            android:summary="Movement speed (0=frozen, 50=normal, 100=fast)"
            android:defaultValue="45"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />
    </PreferenceCategory>

    <!-- Random Events -->
    <PreferenceCategory android:title="Random Events">
        <SwitchPreferenceCompat
            android:key="pref_events_enabled"
            android:title="Random Events"
            android:summary="Birds, planes, deer, and other animals"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_event_frequency"
            android:title="Event Frequency"
            android:summary="How often events spawn (0=rare, 100=frequent)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_airplane"
            android:title="Airplanes"
            android:summary="Planes flying across the sky with contrails"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_birds"
            android:title="Bird Flocks"
            android:summary="Flocks of birds flying across"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_eagle"
            android:title="Eagles"
            android:summary="Soaring eagles in the sky"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_butterfly"
            android:title="Butterflies"
            android:summary="Colorful butterflies fluttering"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_rabbit"
            android:title="Rabbits"
            android:summary="Rabbits hopping around"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_fox"
            android:title="Foxes"
            android:summary="Foxes walking across terrain"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_shootingstar"
            android:title="Shooting Stars"
            android:summary="Shooting stars on clear nights"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_fireflies"
            android:title="Fireflies"
            android:summary="Flickering fireflies on summer nights"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_owl"
            android:title="Owls"
            android:summary="Owl silhouettes at night"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_balloon"
            android:title="Hot Air Balloons"
            android:summary="Balloons drifting in good weather"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_event_alien"
            android:title="UFOs"
            android:summary="Rare alien sightings at night (very rare)"
            android:defaultValue="true"
            android:dependency="pref_events_enabled" />

        <Preference
            android:key="pref_spawn_event"
            android:title="🎲 Spawn Random Event"
            android:summary="Manually trigger a random enabled event"
            android:dependency="pref_events_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_daynight_enabled"
            android:title="Auto Day/Night Cycle"
            android:summary="Change sky colors based on real time"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_night_shade_strength"
            android:title="Night Shade Strength"
            android:summary="How dark nights appear (0=bright, 35=default, 100=very dark)"
            android:defaultValue="35"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <ListPreference
            android:key="pref_max_fps"
            android:title="Max FPS"
            android:entries="@array/fps_options"
            android:entryValues="@array/fps_values"
            android:defaultValue="30" />
    </PreferenceCategory>

    <!-- Weather & Connections -->
    <PreferenceCategory android:title="Weather &amp; Connections">
        <SwitchPreferenceCompat
            android:key="pref_use_breezy_weather"
            android:title="Use Breezy Weather"
            android:summary="Get weather data from Breezy Weather app"
            android:defaultValue="true" />

        <Preference
            android:key="pref_check_breezy"
            android:title="Check Breezy Weather"
            android:summary="Test connection to Breezy Weather app" />
    
        <SwitchPreferenceCompat
            android:key="pref_weather_enabled"
            android:title="Enable Weather Effects"
            android:summary="Show rain, snow, lightning particles"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Seasonal -->
    <PreferenceCategory android:title="Seasonal">
        <SwitchPreferenceCompat
            android:key="pref_seasonal_enabled"
            android:title="Seasonal Events"
            android:summary="Christmas star, New Year fireworks (Dec 15 - Jan 7)"
            android:defaultValue="true" />
            
        <SeekBarPreference
            android:key="pref_christmas_star_size"
            android:title="Christmas Star Size"
            android:summary="Size of Bethlehem star (50-200%)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
            
        <SeekBarPreference
            android:key="pref_christmas_star_trail"
            android:title="Star Trail Length"
            android:summary="Length of the trailing Schweif (0-200%)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
            
        <SeekBarPreference
            android:key="pref_firework_frequency"
            android:title="Firework Frequency"
            android:summary="How often fireworks launch (0=rare, 100=constant)"
            android:defaultValue="45"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
            
        <SeekBarPreference
            android:key="pref_firework_amount"
            android:title="Firework Amount"
            android:summary="Particles per explosion (10=subtle, 200=spectacular)"
            android:defaultValue="100"
            android:max="200"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
    </PreferenceCategory>

    <!-- Simulation / Debug -->
    <PreferenceCategory android:title="Simulation &amp; Debug">
        <SwitchPreferenceCompat
            android:key="pref_debug_enabled"
            android:title="Enable Simulation Mode"
            android:summary="Override weather, time, wind, and season for testing"
            android:defaultValue="false" />

        <info.olli.weatherlwp.prefs.TimeSeekBarPreference
            android:key="pref_manual_time"
            android:title="Simulate Time of Day"
            android:summary="Drag to set simulation time"
            android:defaultValue="720"
            android:max="1439"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />

        <SeekBarPreference
            android:key="pref_wind_strength"
            android:title="Simulate Wind Strength"
            android:summary="Tree sway and cloud speed (0=none, 100=max)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_weather_type"
            android:title="Simulate Weather"
            android:summary="Force specific weather effects"
            android:entries="@array/weather_options"
            android:entryValues="@array/weather_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_cloud_override"
            android:title="Simulate Cloud Density"
            android:summary="Force specific cloud amount"
            android:entries="@array/cloud_density_options"
            android:entryValues="@array/cloud_density_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_season"
            android:title="Simulate Season"
            android:summary="Force Christmas star or New Year fireworks"
            android:entries="@array/season_options"
            android:entryValues="@array/season_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <SeekBarPreference
            android:key="pref_moon_phase"
            android:title="Moon Phase"
            android:summary="0=New, 50=Full, 100=New (cycle end)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />
    </PreferenceCategory>

    <!-- About -->
    <PreferenceCategory android:title="About">
        <Preference
            android:key="pref_version"
            android:title="Version"
            android:selectable="true" />

        <Preference
            android:key="pref_export_log"
            android:title="Export Debug Log"
            android:summary="Generate log file for troubleshooting" />

        <Preference
            android:key="pref_preview"
            android:title="Preview Wallpaper"
            android:summary="Open wallpaper preview" />
    </PreferenceCategory>

</PreferenceScreen>
