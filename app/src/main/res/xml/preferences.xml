<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Scene Settings -->
    <PreferenceCategory android:title="Scene">
        <SeekBarPreference
            android:key="pref_mountain_count"
            android:title="Mountain Count"
            android:summary="Number of mountain peaks (0-10)"
            android:defaultValue="4"
            android:max="10"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_width"
            android:title="Mountain Width"
            android:summary="Width multiplier (50-1000%)"
            android:defaultValue="500"
            android:max="1000"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_height"
            android:title="Mountain Height"
            android:summary="Height multiplier (10-1000%)"
            android:defaultValue="140"
            android:max="1000"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_roughness"
            android:title="Mountain Roughness"
            android:summary="Jaggedness of silhouette (0-100%)"
            android:defaultValue="25"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_count"
            android:title="Hill Layers"
            android:summary="Rolling terrain layers (0-50)"
            android:defaultValue="25"
            android:max="50"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_lower_start"
            android:title="Hills Start Position"
            android:summary="Where far hills appear on screen (30-70%)"
            android:defaultValue="50"
            android:max="70"
            app:min="30"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_upper_end"
            android:title="Hills End Position"
            android:summary="Where near hills appear on screen (60-90%)"
            android:defaultValue="85"
            android:max="90"
            app:min="60"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_count"
            android:title="Tree Count"
            android:summary="Number of trees (0-200)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_size"
            android:title="Tree Size"
            android:summary="Size multiplier"
            android:defaultValue="200"
            android:max="1000"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_segments"
            android:title="Tree Segments"
            android:summary="Tiers per tree (1-5, fewer = taller)"
            android:defaultValue="1"
            android:max="5"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_color_variation"
            android:title="Tree Color Variation"
            android:summary="Color diversity (0=uniform, 100=varied)"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_wind_strength"
            android:title="Wind Strength"
            android:summary="Tree sway intensity (0=none, 100=max, or auto from weather)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <!-- 3D Parallax Settings -->
    <PreferenceCategory android:title="3D Parallax">
        <SwitchPreferenceCompat
            android:key="pref_parallax_enabled"
            android:title="Enable 3D Parallax"
            android:summary="Sensor-based parallax effect"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_parallax_strength"
            android:title="Parallax Strength"
            android:summary="How much the scene moves"
            android:defaultValue="150"
            android:max="300"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />
    </PreferenceCategory>

    <!-- Visual Effects -->
    <PreferenceCategory android:title="Visual Effects">
        <SwitchPreferenceCompat
            android:key="pref_clouds_enabled"
            android:title="Clouds"
            android:summary="Enable moving clouds in the sky"
            android:defaultValue="true" />

        <ListPreference
            android:key="pref_cloud_density"
            android:title="Cloud Density"
            android:summary="Auto uses Breezy Weather data"
            android:entries="@array/cloud_density_options"
            android:entryValues="@array/cloud_density_values"
            android:defaultValue="auto"
            android:dependency="pref_clouds_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_daynight_enabled"
            android:title="Auto Day/Night Cycle"
            android:summary="Change sky colors based on real time"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_manual_time"
            android:title="Manual Time of Day"
            android:summary="Used when Auto Day/Night is OFF (0:00-23:59)"
            android:defaultValue="720"
            android:max="1439"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <ListPreference
            android:key="pref_max_fps"
            android:title="Max FPS"
            android:entries="@array/fps_options"
            android:entryValues="@array/fps_values"
            android:defaultValue="30" />
    </PreferenceCategory>

    <!-- Weather & Connections -->
    <PreferenceCategory android:title="Weather &amp; Connections">
        <SwitchPreferenceCompat
            android:key="pref_use_breezy_weather"
            android:title="Use Breezy Weather"
            android:summary="Get weather data from Breezy Weather app"
            android:defaultValue="true" />

        <Preference
            android:key="pref_check_breezy"
            android:title="Check Breezy Weather"
            android:summary="Test connection to Breezy Weather app" />
    
        <SwitchPreferenceCompat
            android:key="pref_weather_enabled"
            android:title="Enable Weather Effects"
            android:summary="Show rain, snow, lightning particles"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Seasonal -->
    <PreferenceCategory android:title="Seasonal">
        <SwitchPreferenceCompat
            android:key="pref_seasonal_enabled"
            android:title="Seasonal Events"
            android:summary="Christmas star, New Year fireworks (Dec 15 - Jan 7)"
            android:defaultValue="true" />
            
        <SeekBarPreference
            android:key="pref_christmas_star_size"
            android:title="Christmas Star Size"
            android:summary="Size of Bethlehem star (50-200%)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
            
        <SeekBarPreference
            android:key="pref_christmas_star_trail"
            android:title="Star Trail Length"
            android:summary="Length of the trailing Schweif (0-200%)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_seasonal_enabled" />
    </PreferenceCategory>

    <!-- Simulation / Debug -->
    <PreferenceCategory android:title="Simulation &amp; Debug">
        <SwitchPreferenceCompat
            android:key="pref_debug_enabled"
            android:title="Enable Simulation Mode"
            android:summary="Override time, weather, and season for testing"
            android:defaultValue="false" />

        <ListPreference
            android:key="pref_debug_time"
            android:title="Simulate Time of Day"
            android:summary="Force specific time (overrides auto day/night)"
            android:entries="@array/time_options"
            android:entryValues="@array/time_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_weather_type"
            android:title="Simulate Weather"
            android:summary="Force specific weather effects"
            android:entries="@array/weather_options"
            android:entryValues="@array/weather_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_cloud_override"
            android:title="Simulate Cloud Density"
            android:summary="Force specific cloud amount"
            android:entries="@array/cloud_density_options"
            android:entryValues="@array/cloud_density_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_season"
            android:title="Simulate Season"
            android:summary="Force Christmas star or New Year fireworks"
            android:entries="@array/season_options"
            android:entryValues="@array/season_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <SeekBarPreference
            android:key="pref_debug_wind_speed"
            android:title="Simulate Wind Speed"
            android:summary="Tree sway intensity (0-100%)"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />
    </PreferenceCategory>

    <!-- About -->
    <PreferenceCategory android:title="About">
        <Preference
            android:key="pref_version"
            android:title="Version"
            android:selectable="false" />

        <Preference
            android:key="pref_export_log"
            android:title="Export Debug Log"
            android:summary="Generate log file for troubleshooting" />

        <Preference
            android:key="pref_preview"
            android:title="Preview Wallpaper"
            android:summary="Open wallpaper preview" />
    </PreferenceCategory>

</PreferenceScreen>
