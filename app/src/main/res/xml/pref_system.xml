<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Time & Weather -->
    <PreferenceCategory android:title="Time &amp; Weather">
        <SwitchPreferenceCompat
            android:key="pref_daynight_enabled"
            android:title="Auto Day/Night"
            android:summary="Sky colors based on real time"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_use_breezy_weather"
            android:title="Use Breezy Weather"
            android:summary="Get weather from Breezy Weather app"
            android:defaultValue="true" />

        <Preference
            android:key="pref_check_breezy"
            android:title="Check Connection"
            android:summary="Test Breezy Weather connection" />

        <Preference
            android:key="pref_copy_weather_data"
            android:title="Copy Weather Data"
            android:summary="Copy raw JSON to clipboard for debugging" />

        <SwitchPreferenceCompat
            android:key="pref_weather_enabled"
            android:title="Weather Effects"
            android:summary="Rain, snow, lightning particles"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Performance -->
    <PreferenceCategory android:title="Performance">
        <ListPreference
            android:key="pref_max_fps"
            android:title="Max FPS"
            android:summary="Frame rate limit"
            android:entries="@array/fps_options"
            android:entryValues="@array/fps_values"
            android:defaultValue="30" />

        <SwitchPreferenceCompat
            android:key="pref_idle_mode_enabled"
            android:title="Idle Mode"
            android:summary="Reduce FPS when scene is static (battery saver)"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_idle_fps"
            android:title="Idle FPS"
            android:summary="Frame rate when idle (5-20)"
            android:defaultValue="10"
            android:max="20"
            app:min="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_idle_mode_enabled" />

        <SeekBarPreference
            android:key="pref_idle_timeout"
            android:title="Idle Timeout"
            android:summary="Seconds before entering idle mode (1-10)"
            android:defaultValue="5"
            android:max="10"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_idle_mode_enabled" />
    </PreferenceCategory>

    <!-- Simulation Mode -->
    <PreferenceCategory android:title="Simulation Mode">
        <SwitchPreferenceCompat
            android:key="pref_debug_enabled"
            android:title="Enable Simulation"
            android:summary="Override weather, time, wind for testing"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="pref_manual_time"
            android:title="Time of Day"
            android:summary="Minutes since midnight (0-1439)"
            android:defaultValue="720"
            android:max="1439"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />

        <SeekBarPreference
            android:key="pref_wind_strength"
            android:title="Wind Strength"
            android:summary="Simulated wind (0=calm, 100=storm)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_weather_type"
            android:title="Weather Type"
            android:summary="Force specific weather"
            android:entries="@array/weather_options"
            android:entryValues="@array/weather_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_cloud_override"
            android:title="Cloud Density"
            android:summary="Force cloud amount"
            android:entries="@array/cloud_density_options"
            android:entryValues="@array/cloud_density_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_debug_season"
            android:title="Season Override"
            android:summary="Force seasonal events"
            android:entries="@array/season_options"
            android:entryValues="@array/season_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <ListPreference
            android:key="pref_terrain_season"
            android:title="Terrain Season"
            android:summary="Override terrain (flowers, grass, snow)"
            android:entries="@array/terrain_season_options"
            android:entryValues="@array/terrain_season_values"
            android:defaultValue="auto"
            android:dependency="pref_debug_enabled" />

        <SeekBarPreference
            android:key="pref_moon_phase"
            android:title="Moon Phase"
            android:summary="0=New, 50=Full, 100=New (cycle end)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_debug_enabled" />
    </PreferenceCategory>

    <!-- About -->
    <PreferenceCategory android:title="About">
        <Preference
            android:key="pref_version"
            android:title="Version"
            android:selectable="true" />

        <SwitchPreferenceCompat
            android:key="pref_debug_logging"
            android:title="Debug Logging"
            android:summary="Enable tracing (copies log when disabled)"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_debug_frame_timing"
            android:title="Frame Timing"
            android:summary="Log slow frames (&gt;16ms) for performance analysis"
            android:defaultValue="false" />

        <info.olli.weatherlwp.settings.DebugOverlayPreference
            android:key="pref_debug_overlay_enabled"
            android:title="🐞 Debug Overlay"
            android:summary="Show FPS, frame time, and debug info on screen"
            android:defaultValue="false" />

        <Preference
            android:key="pref_preview"
            android:title="Preview Wallpaper"
            android:summary="Open wallpaper preview" />
    </PreferenceCategory>

</PreferenceScreen>
