<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- System - Essential settings only, details in sub-screens -->
    <PreferenceCategory android:title="Time &amp; Weather">
        <SwitchPreferenceCompat
            android:key="pref_daynight_enabled"
            android:title="Auto Day/Night"
            android:summary="Sky colors based on real time"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_use_breezy_weather"
            android:title="Use Breezy Weather"
            android:summary="Get weather from Breezy Weather app"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_weather_enabled"
            android:title="Weather Effects"
            android:summary="Rain, snow, lightning particles"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Performance">
        <ListPreference
            android:key="pref_max_fps"
            android:title="Max FPS"
            android:summary="Frame rate limit"
            android:entries="@array/fps_options"
            android:entryValues="@array/fps_values"
            android:defaultValue="30" />

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_idle_mode_enabled"
            android:title="Idle Mode"
            android:summary="Idle FPS, timeout duration"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.SystemIdleFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Testing">
        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_debug_enabled"
            android:title="Simulation Mode"
            android:summary="Time, wind, weather, season overrides"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.SystemSimulationFragment" />

        <Preference
            android:key="pref_nav_about"
            android:title="About &amp; Debug"
            android:summary="Version, logging, weather data, export"
            app:fragment="info.olli.weatherlwp.settings.SystemAboutFragment" />
    </PreferenceCategory>

</PreferenceScreen>
