<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Effects - Essential toggles only, details in sub-screens -->
    <PreferenceCategory android:title="Quick Settings">
        <SeekBarPreference
            android:key="pref_night_shade_strength"
            android:title="Night Shade Strength"
            android:summary="How dark nights appear (0=bright, 35=default, 100=very dark)"
            android:defaultValue="35"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Customize">
        <Preference
            android:key="pref_nav_sky"
            android:title="Sky &amp; Wind"
            android:summary="Sun, moon, celestial size, tree sway"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_sky" />
        </Preference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_parallax_enabled"
            android:title="3D Parallax"
            android:summary="Sensor, sensitivity, depth, smoothing"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_parallax" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_clouds_enabled"
            android:title="Clouds"
            android:summary="Fluffiness, shape, opacity, speed, render mode"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_clouds" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_weather_enabled"
            android:title="Weather &amp; Shadows"
            android:summary="Rain/snow particles, shadow settings"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_weather_shadows" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_seasonal_enabled"
            android:title="Seasonal Terrain"
            android:summary="Flowers, leaves, mushrooms, pinecones, frost, snow"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_seasonal" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_river_enabled"
            android:title="River"
            android:summary="Optional river with weather-driven water level"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_river" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_lake_enabled"
            android:title="Lake"
            android:summary="Still body of water, reacts to weather"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_lake" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_vignette_enabled"
            android:title="Edge Vignette"
            android:summary="Screen edge darkening (bottom, top, sides)"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_vignette" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>
    </PreferenceCategory>

</PreferenceScreen>
