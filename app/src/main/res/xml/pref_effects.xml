<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Effects - Essential toggles only, details in sub-screens -->
    <PreferenceCategory android:title="@string/pref_effects_cat_2_title">
        <SeekBarPreference
            android:key="pref_night_shade_strength"
            android:title="@string/pref_night_shade_strength_title"
            android:summary="@string/pref_night_shade_strength_summary"
            android:defaultValue="35"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_effects_cat_3_title">
        <Preference
            android:key="pref_nav_sky"
            android:title="@string/pref_nav_sky_title"
            android:summary="@string/pref_nav_sky_summary"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_sky" />
        </Preference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_parallax_enabled"
            android:title="@string/pref_parallax_enabled_title"
            android:summary="@string/pref_parallax_enabled_summary"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_parallax" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_clouds_enabled"
            android:title="@string/pref_clouds_enabled_title"
            android:summary="@string/pref_clouds_enabled_summary"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_clouds" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_weather_enabled"
            android:title="@string/pref_weather_enabled_title"
            android:summary="@string/pref_weather_enabled_summary"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_weather_shadows" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_seasonal_enabled"
            android:title="@string/pref_seasonal_enabled_title"
            android:summary="@string/pref_seasonal_enabled_summary"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_seasonal" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_river_enabled"
            android:title="@string/pref_river_enabled_title"
            android:summary="@string/pref_river_enabled_summary"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_river" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_lake_enabled"
            android:title="@string/pref_lake_enabled_title"
            android:summary="@string/pref_lake_enabled_summary"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_lake" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>

        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_vignette_enabled"
            android:title="@string/pref_vignette_enabled_title"
            android:summary="@string/pref_vignette_enabled_summary"
            android:defaultValue="false"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_effects_vignette" />
        </info.olli.weatherlwp.settings.ToggleNavPreference>
    </PreferenceCategory>

</PreferenceScreen>
