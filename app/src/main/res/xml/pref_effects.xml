<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Effects - Essential toggles only, details in sub-screens -->
    <PreferenceCategory android:title="Key Effects">
        <SwitchPreferenceCompat
            android:key="pref_parallax_enabled"
            android:title="Enable 3D Parallax"
            android:summary="Tilt phone to look around the scene"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_clouds_enabled"
            android:title="Enable Clouds"
            android:summary="Moving clouds in the sky"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_night_shade_strength"
            android:title="Night Shade Strength"
            android:summary="How dark nights appear (0=bright, 35=default, 100=very dark)"
            android:defaultValue="35"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Customize">
        <Preference
            android:key="pref_nav_sky"
            android:title="Sky &amp; Wind"
            android:summary="Sun, moon, celestial size, tree sway"
            app:fragment="info.olli.weatherlwp.settings.EffectsSkyFragment" />

        <Preference
            android:key="pref_nav_parallax"
            android:title="3D Parallax"
            android:summary="Sensor, sensitivity, depth, smoothing"
            app:fragment="info.olli.weatherlwp.settings.EffectsParallaxFragment" />

        <Preference
            android:key="pref_nav_clouds"
            android:title="Clouds"
            android:summary="Fluffiness, shape, opacity, speed, render mode"
            app:fragment="info.olli.weatherlwp.settings.EffectsCloudsFragment" />

        <Preference
            android:key="pref_nav_weather_shadows"
            android:title="Weather &amp; Shadows"
            android:summary="Rain/snow particles, shadow settings"
            app:fragment="info.olli.weatherlwp.settings.EffectsWeatherShadowsFragment" />

        <Preference
            android:key="pref_nav_seasonal"
            android:title="Seasonal Terrain"
            android:summary="Flowers, leaves, mushrooms, pinecones, frost, snow"
            app:fragment="info.olli.weatherlwp.settings.EffectsSeasonalFragment" />

        <Preference
            android:key="pref_nav_river"
            android:title="River"
            android:summary="Optional river with weather-driven water level"
            app:fragment="info.olli.weatherlwp.settings.EffectsRiverFragment" />

        <Preference
            android:key="pref_nav_vignette"
            android:title="Edge Vignette"
            android:summary="Screen edge darkening (bottom, top, sides)"
            app:fragment="info.olli.weatherlwp.settings.EffectsVignetteFragment" />
    </PreferenceCategory>

</PreferenceScreen>
