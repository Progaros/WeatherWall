<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Sky & Celestial -->
    <PreferenceCategory android:title="Sky">
        <SwitchPreferenceCompat
            android:key="pref_sun_enabled"
            android:title="Show Sun"
            android:summary="Display sun in daytime sky"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_moon_enabled"
            android:title="Show Moon"
            android:summary="Display moon at night"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_celestial_size"
            android:title="Sun/Moon Size"
            android:summary="Size of celestial bodies (50=small, 100=normal, 200=large)"
            android:defaultValue="100"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_celestial_arc_height"
            android:title="Arc Height"
            android:summary="How high sun/moon travel (100=top, 50=middle, 0=near horizon)"
            android:defaultValue="66"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <!-- Wind Effects -->
    <PreferenceCategory android:title="Wind Animation">
        <SeekBarPreference
            android:key="pref_wind_multiplier"
            android:title="Tree Flexibility"
            android:summary="How much trees bend in gusts (0=rigid, 100=normal, 300=very flexible)"
            android:defaultValue="200"
            android:max="300"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_sway_speed"
            android:title="Sway Speed"
            android:summary="How fast trees sway back (0=frozen, 100=normal, 200=fast)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <!-- 3D Parallax Settings -->
    <PreferenceCategory android:title="3D Parallax">
        <SwitchPreferenceCompat
            android:key="pref_parallax_enabled"
            android:title="Enable 3D Parallax"
            android:summary="Tilt phone to look around the scene"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_parallax_strength"
            android:title="Tilt Sensitivity"
            android:summary="Response to phone tilt (0=off, 25=normal, 50=high)"
            android:defaultValue="25"
            android:max="50"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_max_offset"
            android:title="Max Movement"
            android:summary="How far scene can shift (pixels)"
            android:defaultValue="130"
            android:max="200"
            app:min="20"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_return_speed"
            android:title="Return Speed"
            android:summary="Recenter time (1=instant, 50=medium, 100=slow)"
            android:defaultValue="10"
            android:max="100"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_smoothing"
            android:title="Smoothing"
            android:summary="Movement smoothness (1=responsive, 100=floaty)"
            android:defaultValue="30"
            android:max="100"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_depth"
            android:title="Depth Effect"
            android:summary="Layer separation (0=flat, 50=normal, 100=max 3D)"
            android:defaultValue="33"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />

        <SeekBarPreference
            android:key="pref_parallax_perspective"
            android:title="Perspective"
            android:summary="0=foreground moves (head tilts), 100=background moves (window shifts)"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_parallax_enabled" />
    </PreferenceCategory>

    <!-- Cloud Settings -->
    <PreferenceCategory android:title="Clouds">
        <SwitchPreferenceCompat
            android:key="pref_clouds_enabled"
            android:title="Enable Clouds"
            android:summary="Moving clouds in the sky"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_cloud_density"
            android:title="Cloud Fluffiness"
            android:summary="Density per cloud (50=thin, 100=normal, 300=fluffy)"
            android:defaultValue="100"
            android:max="300"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_stretch"
            android:title="Cloud Shape"
            android:summary="Horizontal stretch (100=round, 400=wispy)"
            android:defaultValue="300"
            android:max="500"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_opacity"
            android:title="Cloud Opacity"
            android:summary="Transparency (10=faint, 50=normal, 100=solid)"
            android:defaultValue="60"
            android:max="100"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SeekBarPreference
            android:key="pref_cloud_speed"
            android:title="Cloud Speed"
            android:summary="Movement speed (0=frozen, 50=normal, 100=fast)"
            android:defaultValue="10"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_clouds_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_cloud_shadows"
            android:title="Cloud Shadows"
            android:summary="Clouds cast soft shadows on terrain"
            android:defaultValue="true"
            android:dependency="pref_clouds_enabled" />
    </PreferenceCategory>

    <!-- Shadows & Lighting -->
    <PreferenceCategory android:title="Shadows &amp; Lighting">
        <SwitchPreferenceCompat
            android:key="pref_shadows_enabled"
            android:title="Enable Shadows"
            android:summary="Trees and mountains cast shadows"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_shadow_strength"
            android:title="Shadow Intensity"
            android:summary="Darkness of shadows (0=subtle, 50=normal, 100=strong)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_shadows_enabled" />
    </PreferenceCategory>

    <!-- Seasonal Terrain Effects -->
    <PreferenceCategory android:title="Seasonal Terrain">
        <!-- Note: Terrain Season Override is in Simulation Mode (System settings) -->

        <!-- Spring Flowers -->
        <SwitchPreferenceCompat
            android:key="pref_spring_flowers"
            android:title="Spring Flowers"
            android:summary="Colorful flower dots on hills in spring"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_spring_flower_density"
            android:title="Flower Density"
            android:summary="Total flowers across all hills (0=few, 1000=many)"
            android:defaultValue="500"
            android:max="1000"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_spring_flowers" />

        <SeekBarPreference
            android:key="pref_spring_flower_spread"
            android:title="Flower Spread"
            android:summary="How far down hills flowers spread (0=on line, 100=full)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_spring_flowers" />

        <!-- Autumn Grass -->
        <SwitchPreferenceCompat
            android:key="pref_autumn_grass"
            android:title="Autumn Grass Color"
            android:summary="Browner grass color in autumn"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_autumn_grass_intensity"
            android:title="Autumn Intensity"
            android:summary="How brown the grass becomes (0=subtle, 100=very brown)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_autumn_grass" />

        <!-- Winter Snow on Hills -->
        <SwitchPreferenceCompat
            android:key="pref_winter_snow_hills"
            android:title="Winter Snow Patches"
            android:summary="Snow patches on hill tops in winter"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_winter_snow_coverage"
            android:title="Snow Coverage"
            android:summary="How much of hill tops are covered (0=light, 100=heavy)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_winter_snow_hills" />
    </PreferenceCategory>

</PreferenceScreen>
