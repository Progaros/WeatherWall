<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Season Transitions">
        <SwitchPreferenceCompat
            android:key="pref_weather_snow_enabled"
            android:title="Weather-Driven Snow"
            android:summary="Snow accumulates based on actual weather history"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_season_transition_days"
            android:title="Transition Duration"
            android:summary="Days for gradual season change (0=instant, 30=slow)"
            android:defaultValue="14"
            android:max="30"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Spring">
        <SwitchPreferenceCompat
            android:key="pref_spring_flowers"
            android:title="Spring Flowers"
            android:summary="Colorful flower dots on hills in spring"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_spring_flower_density"
            android:title="Flower Density"
            android:summary="Total flowers across all hills (0=few, 1000=many)"
            android:defaultValue="500"
            android:max="1000"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_spring_flowers" />

        <SeekBarPreference
            android:key="pref_spring_flower_spread"
            android:title="Flower Spread"
            android:summary="How far down hills flowers spread (0=on line, 100=full)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_spring_flowers" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Bushes">
        <SwitchPreferenceCompat
            android:key="pref_bushes_enabled"
            android:title="Bushes"
            android:summary="Small round bushes scattered on hills"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_bush_density"
            android:title="Bush Density"
            android:summary="How many bushes (0=few, 100=many)"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_bushes_enabled" />

        <SeekBarPreference
            android:key="pref_bush_size"
            android:title="Bush Size"
            android:summary="Size scale for bushes (50=small, 200=large)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_bushes_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_berries_enabled"
            android:title="Berries on Bushes"
            android:summary="Small berry clusters on bushes (summer)"
            android:defaultValue="true"
            android:dependency="pref_bushes_enabled" />

        <SeekBarPreference
            android:key="pref_berry_density"
            android:title="Berry Density"
            android:summary="Probability of berries per bush (0=rare, 100=many)"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_berries_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Autumn">
        <SwitchPreferenceCompat
            android:key="pref_autumn_grass"
            android:title="Autumn Grass Color"
            android:summary="Browner grass color in autumn"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_autumn_grass_intensity"
            android:title="Autumn Intensity"
            android:summary="How brown the grass becomes (0=subtle, 100=very brown)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_autumn_grass" />

        <SwitchPreferenceCompat
            android:key="pref_fallen_leaves_enabled"
            android:title="Fallen Leaves"
            android:summary="Colorful fallen leaves scattered on hills"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_fallen_leaves_density"
            android:title="Leaf Density"
            android:summary="How many fallen leaves (0=few, 100=many)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_fallen_leaves_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_mushrooms_enabled"
            android:title="Mushrooms"
            android:summary="Small mushrooms on hills (summer + autumn)"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_mushroom_density"
            android:title="Mushroom Density"
            android:summary="How many mushrooms appear (0=few, 100=many)"
            android:defaultValue="20"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_mushrooms_enabled" />

        <SwitchPreferenceCompat
            android:key="pref_pinecones_enabled"
            android:title="Pinecones"
            android:summary="Pinecones hanging from trees (autumn + winter)"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_pinecone_density"
            android:title="Pinecone Density"
            android:summary="Probability of pinecones per tree (0=rare, 100=many)"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_pinecones_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Winter">
        <SwitchPreferenceCompat
            android:key="pref_winter_snow_hills"
            android:title="Winter Snow Patches"
            android:summary="Snow patches on hill tops in winter"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="pref_winter_snow_coverage"
            android:title="Snow Coverage"
            android:summary="How much of hill tops are covered (0=light, 100=heavy)"
            android:defaultValue="25"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_winter_snow_hills" />

        <SwitchPreferenceCompat
            android:key="pref_frost_enabled"
            android:title="Frost Effect"
            android:summary="Subtle frost shimmer along hill edges"
            android:defaultValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
