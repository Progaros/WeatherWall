<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Cloud Appearance">
        <SeekBarPreference
            android:key="pref_cloud_density"
            android:title="Cloud Fluffiness"
            android:summary="Density per cloud (50=thin, 100=normal, 300=fluffy)"
            android:defaultValue="120"
            android:max="300"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_cloud_stretch"
            android:title="Cloud Shape"
            android:summary="Horizontal stretch (100=round, 400=wispy)"
            android:defaultValue="300"
            android:max="500"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_cloud_opacity"
            android:title="Cloud Opacity"
            android:summary="Transparency (10=faint, 40=normal, 100=solid)"
            android:defaultValue="68"
            android:max="100"
            app:min="10"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_cloud_speed"
            android:title="Cloud Speed"
            android:summary="Movement speed (0=frozen, 50=normal, 100=fast)"
            android:defaultValue="45"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

    </PreferenceCategory>

</PreferenceScreen>
