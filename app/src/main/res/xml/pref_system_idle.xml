<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Idle Mode">
        <SeekBarPreference
            android:key="pref_idle_fps"
            android:title="Idle FPS"
            android:summary="Frame rate when idle (5-20)"
            android:defaultValue="20"
            android:max="20"
            app:min="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <ListPreference
            android:key="pref_idle_timeout"
            android:title="Idle Timeout"
            android:summary="Time before entering idle mode"
            android:defaultValue="5"
            android:entries="@array/idle_timeout_entries"
            android:entryValues="@array/idle_timeout_values" />
    </PreferenceCategory>

</PreferenceScreen>
