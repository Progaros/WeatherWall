<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Events - Essential toggles only, details in sub-screens -->
    <PreferenceCategory android:title="Random Events">
        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_events_enabled"
            android:title="Random Events"
            android:summary="Birds, planes, animals, and more"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.EventsChooseFragment" />

        <SeekBarPreference
            android:key="pref_event_frequency"
            android:title="Event Frequency"
            android:summary="Spawn rate (0=rare, 50=normal, 100=frequent)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true"
            android:dependency="pref_events_enabled" />

        <Preference
            android:key="pref_spawn_event"
            android:title="Spawn Random Event"
            android:summary="Manually trigger a random enabled event"
            android:dependency="pref_events_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Seasonal Events">
        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_seasonal_enabled"
            android:title="Seasonal Effects"
            android:summary="Christmas, New Year, St. Patrick's settings"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.EventsSeasonalFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Shake Gesture">
        <info.olli.weatherlwp.settings.ToggleNavPreference
            android:key="pref_shake_fireworks_enabled"
            android:title="Shake for Fireworks"
            android:summary="Wiggle the phone around its long axis (or shake hard)"
            android:defaultValue="true"
            app:fragment="info.olli.weatherlwp.settings.EventsShakeFragment" />
    </PreferenceCategory>

</PreferenceScreen>
