<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Shake Settings">
        <SeekBarPreference
            android:key="pref_shake_fireworks_count"
            android:title="Firework Count"
            android:summary="Number of fireworks on shake (5-50)"
            android:defaultValue="15"
            android:max="50"
            app:min="5"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_shake_sensitivity"
            android:title="Shake Sensitivity"
            android:summary="How fast and how often to wiggle or shake (0=deliberate, 100=gentle)"
            android:defaultValue="5"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_shake_delay"
            android:title="Unlock Delay"
            android:summary="Ignore shakes after screen on (0-5000ms, prevents accidental triggers)"
            android:defaultValue="3500"
            android:max="5000"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

</PreferenceScreen>
