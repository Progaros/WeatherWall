<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Scene Settings - Essential controls only, details in sub-screens -->
    <PreferenceCategory android:title="Landscape">
        <SeekBarPreference
            android:key="pref_random_seed"
            android:title="Random Seed"
            android:summary="Changes terrain layout (1-999)"
            android:defaultValue="208"
            android:max="999"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Mountains">
        <SeekBarPreference
            android:key="pref_mountain_density"
            android:title="Mountain Density"
            android:summary="Mountain coverage (0=none, 50=normal, 100=dense)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <Preference
            android:key="pref_nav_mountains"
            android:title="Mountain Details"
            android:summary="Width, height, roughness, ridge, position"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_scene_mountains" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:title="Hills">
        <SeekBarPreference
            android:key="pref_hill_count"
            android:title="Hill Layers"
            android:summary="Terrain depth layers (0=none, 5=normal, 20=many)"
            android:defaultValue="5"
            android:max="20"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <Preference
            android:key="pref_nav_hills"
            android:title="Hill Details"
            android:summary="Position, roughness, height, frequency, depth"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_scene_hills" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:title="Trees">
        <SeekBarPreference
            android:key="pref_tree_density"
            android:title="Tree Density"
            android:summary="Coverage (0=none, 45=moderate, 100=normal, 200=dense)"
            android:defaultValue="45"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <Preference
            android:key="pref_nav_trees"
            android:title="Tree Details"
            android:summary="Spread, gaps, size, width, segments, color"
            app:fragment="info.olli.weatherlwp.settings.XmlPreferenceFragment">
            <extra android:name="xml" android:value="pref_scene_trees" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
