<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Scene Settings - Mountains, Hills, Trees -->
    <PreferenceCategory android:title="Landscape">
        <SeekBarPreference
            android:key="pref_random_seed"
            android:title="Random Seed"
            android:summary="Changes terrain layout (1-999)"
            android:defaultValue="208"
            android:max="999"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Mountains">
        <SeekBarPreference
            android:key="pref_mountain_density"
            android:title="Mountain Density"
            android:summary="Mountain coverage (0=none, 50=normal, 100=dense)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_width"
            android:title="Mountain Width"
            android:summary="Width scale (50=narrow, 100=normal, 200=wide)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_height"
            android:title="Mountain Height"
            android:summary="Height scale (50=short, 100=normal, 200=tall)"
            android:defaultValue="100"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_roughness"
            android:title="Mountain Roughness"
            android:summary="Jaggedness (0=smooth, 100=normal, 200=rough)"
            android:defaultValue="80"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_ridge_roughness"
            android:title="Ridge Roughness"
            android:summary="Center ridge detail (0=smooth, 100=jagged)"
            android:defaultValue="50"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_mountain_bottom_offset"
            android:title="Mountain Position"
            android:summary="Shift mountains up (0=bottom, 50=halfway)"
            android:defaultValue="0"
            android:max="50"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Hills">
        <SeekBarPreference
            android:key="pref_hill_count"
            android:title="Hill Layers"
            android:summary="Terrain depth layers (0=none, 5=normal, 20=many)"
            android:defaultValue="5"
            android:max="20"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_lower_start"
            android:title="Far Hills Position"
            android:summary="Where far hills start (30-70%)"
            android:defaultValue="60"
            android:max="70"
            app:min="30"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_upper_end"
            android:title="Near Hills Position"
            android:summary="Where near hills end (60-100%)"
            android:defaultValue="95"
            android:max="100"
            app:min="60"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_roughness"
            android:title="Hill Roughness"
            android:summary="Curve detail (0=smooth, 100=normal, 200=rough)"
            android:defaultValue="100"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_amplitude"
            android:title="Hill Height"
            android:summary="Vertical scale (0=flat, 100=normal, 1000=extreme)"
            android:defaultValue="354"
            android:max="1000"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_frequency"
            android:title="Hill Frequency"
            android:summary="Hills per layer (50=few, 100=normal, 200=many)"
            android:defaultValue="170"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_distance"
            android:title="Hill Distance"
            android:summary="Pushes hills away (0=at camera, 100=near mountains)"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_hill_depth_spread"
            android:title="Hill Depth Spread"
            android:summary="Z-axis spread (0=flat layer, 100=deep range)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Trees">
        <SeekBarPreference
            android:key="pref_tree_density"
            android:title="Tree Density"
            android:summary="Coverage (0=none, 50=normal, 200=dense forest)"
            android:defaultValue="50"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_spread"
            android:title="Tree Spread"
            android:summary="Placement range (0=peaks, 100=full hills)"
            android:defaultValue="80"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_sparsity"
            android:title="Tree Gaps"
            android:summary="Gap size (0=uniform, 30=natural, 80=sparse)"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_size_randomness"
            android:title="Size Variation"
            android:summary="Tree size variety (0=uniform, 100=varied)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_size"
            android:title="Tree Size"
            android:summary="Overall scale (50=small, 100=normal, 200=tall)"
            android:defaultValue="100"
            android:max="200"
            app:min="25"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_width"
            android:title="Tree Width"
            android:summary="Width ratio (50=thin, 100=normal, 200=wide)"
            android:defaultValue="100"
            android:max="200"
            app:min="20"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_segments"
            android:title="Tree Segments"
            android:summary="Tiers per tree (1=simple, 5=detailed)"
            android:defaultValue="1"
            android:max="5"
            app:min="1"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

        <SeekBarPreference
            android:key="pref_tree_color_variation"
            android:title="Color Variation"
            android:summary="Color diversity (0=uniform, 100=varied)"
            android:defaultValue="50"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

</PreferenceScreen>
