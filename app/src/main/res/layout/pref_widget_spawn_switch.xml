<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Animated Event Preview -->
    <info.olli.weatherlwp.settings.EventPreviewView
        android:id="@+id/event_preview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp" />

    <!-- Spawn Button (Inline) -->
    <ImageButton
        android:id="@+id/spawn_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_dice"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Spawn Event"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginEnd="8dp"
        android:scaleType="centerInside"
        android:padding="8dp" />

    <!-- The Switch - ID matches AndroidX expectation for auto-binding -->
    <!-- Note: clickable=true and focusable=true allow the switch to respond to clicks -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@android:id/switch_widget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
